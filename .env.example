# UDYOGA Environment Configuration
# Copy this file to .env and configure local values

# Application
APP_ENV=development
APP_NAME="UDYOGA Financial Intelligence Platform"
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (SQLite for Hackathon)
DATABASE_URL=sqlite+aiosqlite:///./udyoga.db

# LLM Providers (Optional for Phase 0 deterministic mock / Required for Phase 1 LLM Agents)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
